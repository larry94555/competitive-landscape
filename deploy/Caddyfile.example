# TLS, and the only thing on the box listening to the internet.
#
# Caddy gets a Let's Encrypt certificate by itself, which is the whole reason it is here rather
# than nginx: one less thing to renew and forget.
#
# **The allow-list is here rather than in the firewall, and review is the reason.** Restricting
# ports 80 and 443 to one address at the Oracle security list made the procedure impossible:
# the certificate authority has to reach this host to validate the domain, and it does not come
# from your address. So the ports are open to the internet, the certificate can be issued and
# renewed, and the *application* is the thing behind a list of one.
#
# Until D6 exists — a per-IP cap — this is what stands between a public URL and unlimited
# inference on four cores.

landscape.example.com {
    # Your address. `curl -4 -s https://ifconfig.me` on the machine you will browse from.
    #
    # **The `-4` matters.** Without it that command returns an IPv6 address whenever the client
    # has one, while a domain with only an A record is reached over IPv4 - so the list would
    # hold an address that never arrives and every request would be refused with the 403 below.
    #
    # Several values and CIDR ranges are allowed: `remote_ip 203.0.113.4 198.51.100.0/24`.
    # If you are already seeing "Not open yet.", the address Caddy actually saw is in its log:
    # `journalctl -u caddy --no-pager | grep -o '"remote_ip":"[^"]*"' | tail -5`
    @allowed remote_ip 203.0.113.4

    handle @allowed {
        encode gzip

        # Server-sent events. Buffering them would turn a report that fills in over ninety
        # seconds into one that appears all at once at the end — the feature, undone by a proxy.
        reverse_proxy 127.0.0.1:8787 {
            flush_interval -1
        }
    }

    # Everybody else, including whoever finds the domain in a certificate transparency log
    # minutes after it is issued.
    handle {
        respond "Not open yet." 403
    }
}
