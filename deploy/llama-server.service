# The extraction model.
#
# Qwen3-4B Q4_K_M, which is the model the golden set is scored against — `docs/MODEL_BAKEOFF.md`
# and ADR 0007. The 1.7B is a router, not an extractor: it invented a price on a contact-sales
# page, which is the one failure this product cannot ship.
#
# `--ctx-size 12288` matches what the bake-off measured. Span pre-selection means a prompt is a
# window rather than a page, so this is generous rather than tight.

[Unit]
Description=llama-server (Qwen3-4B Q4_K_M)
Documentation=https://github.com/larry94555/competitive-landscape/blob/main/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=landscape
Group=landscape
WorkingDirectory=/opt/landscape
ExecStart=/opt/landscape/bin/llama-server \
    --model /opt/landscape/models/Qwen3-4B-Q4_K_M.gguf \
    --host 127.0.0.1 \
    --port 8080 \
    --ctx-size 12288 \
    --threads 4

# **This is what makes the unit "started" mean "answering".** With `Type=simple` systemd counts
# the service as up the instant it forks, so `TimeoutStartSec` alone bounds nothing — review
# caught the unit claiming otherwise. `ExecStartPost` runs inside the start timeout, so polling
# until /health answers gives the timeout something real to bound, and makes the worker's
# `After=` mean the model is loaded rather than merely spawned.
ExecStartPost=/bin/sh -c 'until curl -sf http://127.0.0.1:8080/health >/dev/null; do sleep 5; done'
# Loading two and a half gigabytes off a free-tier volume is not fast, and a restart loop during
# it would look exactly like a crash loop.
TimeoutStartSec=600s

Restart=on-failure
RestartSec=10s

# The model is ~2.5GB of weights plus the KV cache for a 12k context. RUNBOOK.md section 2 asks
# for this on every unit: without it, a model that grows past what is free takes the database and
# the API down with it, and the journal shows three services dying at once instead of one.
MemoryMax=8G

# It reads a model file and answers on localhost. Nothing else, and nothing writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
