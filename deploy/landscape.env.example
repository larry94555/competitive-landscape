# Everything environmental, in one file.
#
# **This is the whole of what differs between a laptop and the box.** If deploying ever needs
# a change to the code rather than a change to this file, that is a defect to fix and not a
# step to add — `docs/Full_Feature_List.md` states that as the invariant the deployment track
# depends on.
#
# Copy to /etc/landscape/landscape.env, then `chmod 600` it: it holds a database password.

# Where the API listens. 127.0.0.1 on purpose — Caddy terminates TLS in front of it, and a
# process bound to 0.0.0.0 is reachable from the internet the moment a firewall rule is wrong.
BIND_ADDR=127.0.0.1:8787

# The database. The password is the one you set in step 3 of docs/DEPLOY.md.
DATABASE_URL=postgres://landscape:CHANGE_ME@127.0.0.1:5432/landscape

# The model server, on this machine. Not 8787: that is this application, and 8080 is
# llama.cpp's own default.
LLAMA_URL=http://127.0.0.1:8080

# The built web app. Absolute, because systemd's working directory is not your shell's.
WEB_DIR=/opt/landscape/web/dist

# Our own crates are named individually: `landscape=info` does not match `landscape_api`,
# which is a sibling target rather than a child. A default that hides our own logs is not a
# default — that cost an hour once, and the reason is in main.rs.
RUST_LOG=landscape=info,landscape_api=info,landscape_db=info,landscape_llm=info,tower_http=info
